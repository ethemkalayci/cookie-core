<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.cookies.studio.core.controller.ShellController" styleClass="app-shell" fx:id="shellRoot">
 <left><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" fx:id="sidebarScroll" prefWidth="232" minWidth="232" maxWidth="232">
 <content><VBox styleClass="sidebar" fx:id="sidebarContent" spacing="8" minHeight="0">
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
   <ImageView fitWidth="36" fitHeight="36" preserveRatio="true"><image><Image url="@../images/logo/logo-core.png"/></image></ImageView>
   <VBox spacing="2"><Label text="COOKIE CORE" styleClass="brand-title"/><Label text="COOKIES STUDIO" styleClass="brand-caption"/></VBox>
  </HBox>
  <Label text="EXPLORER" styleClass="nav-caption"/>
  <Button fx:id="accueilButton" text="Accueil" maxWidth="Infinity" styleClass="nav-button"/>
  <Button fx:id="instancesButton" text="Instances" maxWidth="Infinity" styleClass="nav-button"/>
  <Button fx:id="vanillaButton" text="Minecraft Vanilla" maxWidth="Infinity" styleClass="nav-button"/>
  <Button fx:id="downloadsButton" text="Téléchargements" maxWidth="Infinity" styleClass="nav-button"/>
  <Region minHeight="0" VBox.vgrow="ALWAYS"/>
  <Separator/>
  <Label text="TON ESPACE" styleClass="nav-caption"/>
  <Button fx:id="settingsButton" text="Paramètres" maxWidth="Infinity" styleClass="nav-button"/>
  <Button fx:id="accountButton" text="Compte Minecraft" maxWidth="Infinity" styleClass="nav-button"/>
 </VBox></content></ScrollPane></left>
 <center><BorderPane fx:id="contentContainer" minWidth="0" styleClass="page-host"/></center>
</BorderPane>