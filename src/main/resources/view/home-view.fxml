                     <children>

                        <!-- Dégradé diagonal -->
                        <Region mouseTransparent="true" styleClass="banner-gradient" />

                        <!-- Fondu inférieur -->
                        <Region maxHeight="-Infinity" mouseTransparent="true" prefHeight="180.0" styleClass="banner-bottom-fade" StackPane.alignment="BOTTOM_CENTER" />

