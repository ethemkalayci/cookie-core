                              </Button>

                           </children>

                           <StackPane.margin>
                              <Insets left="52.0" />
                           </StackPane.margin>

                        </VBox>

                        <!-- Bouton notifications -->
                        <Button fx:id="newsButton" accessibleText="Actualités" mnemonicParsing="false" styleClass="home-notification-button" StackPane.alignment="TOP_RIGHT">

                           <StackPane.margin>
                              <Insets right="38.0" top="36.0" />
                           </StackPane.margin>

