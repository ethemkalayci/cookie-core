<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="be.cookies.studio.core.controller.NewsCardController"
      minWidth="280.0"
      prefWidth="280.0"
      maxWidth="280.0"
      minHeight="380.0"
      maxHeight="Infinity"
      styleClass="news-card"
      stylesheets="@../css/style.css">
   <children>
      <!-- Image de l'actualité -->
      <ImageView fx:id="newsImage"
                 fitWidth="280.0"
                 fitHeight="145.0"
                 preserveRatio="true"
                 pickOnBounds="true"/>
      <!-- Contenu de la carte -->
      <VBox spacing="10.0"
            minHeight="-Infinity"
            styleClass="news-card-content"
            VBox.vgrow="ALWAYS">
         <children>
            <Label fx:id="categorieLabel"
                   styleClass="news-card-category"
                   text="Catégorie"/>
            <Label fx:id="titreLabel"
                   styleClass="news-card-title"
                   text="Titre"
                   minHeight="-Infinity"
                   maxWidth="Infinity"
                   wrapText="true"/>
            <Label fx:id="descriptionLabel"
                   styleClass="news-card-description"
                   text="Description"
                   minHeight="-Infinity"
                   maxWidth="Infinity"
                   wrapText="true"/>
            <!-- Espace flexible vertical -->
            <Region VBox.vgrow="ALWAYS"/>
            <Separator styleClass="news-card-separator"/>
            <!-- Date et bouton alignés en bas -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10.0">
               <children>
                  <Label fx:id="dateLabel"
                         styleClass="news-card-date"
                         text="Date"/>
                  <!-- Espace flexible horizontal -->
                  <Region HBox.hgrow="ALWAYS"/>
                  <Button fx:id="viewNewsButton"
                          text="Voir"
                          mnemonicParsing="false"
                          styleClass="news-card-view-button"
                          onAction="#openNews"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
