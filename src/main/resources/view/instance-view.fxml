<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<ScrollPane fx:id="instanceScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="instance-scroll" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.cookies.studio.core.controller.InstanceController">
 <content><VBox spacing="24" styleClass="page">
  <FlowPane fx:id="catalogNotice" visible="false" managed="false" hgap="12" vgap="8"><Label fx:id="catalogStatus" wrapText="true"/><Button fx:id="retryCatalogButton" text="Réessayer"/></FlowPane>
  <StackPane fx:id="bannerPane" prefHeight="420" minHeight="360" styleClass="instance-banner">
   <Pane fx:id="slidesContainer" mouseTransparent="true"><children>
    <StackPane fx:id="currentSlide">
     <ImageView fx:id="instanceBannerImage" preserveRatio="true" smooth="true" mouseTransparent="true"/>
     <Region mouseTransparent="true" styleClass="banner-gradient"/>
   <Region mouseTransparent="true" prefHeight="200" maxHeight="200" styleClass="banner-bottom-fade" StackPane.alignment="BOTTOM_CENTER"/>
     <VBox alignment="CENTER_LEFT" spacing="12" maxHeight="-Infinity" maxWidth="600" styleClass="hero-copy" StackPane.alignment="CENTER_LEFT">
      <StackPane.margin><Insets left="24" right="24" bottom="64" top="24"/></StackPane.margin>
      <Label fx:id="instanceNameLabel" text="Chargement…" styleClass="instance-title" wrapText="true" minHeight="-Infinity"/>
      <Label fx:id="instanceVersionLabel" styleClass="instance-version" wrapText="true" minHeight="-Infinity"/>
     </VBox>
    </StackPane>
   </children></Pane>
   <HBox fx:id="navigationOverlay" alignment="CENTER_LEFT" spacing="12" maxHeight="-Infinity" styleClass="hero-toolbar" StackPane.alignment="BOTTOM_CENTER">
    <Button fx:id="instancePlayButton" text="Installer" styleClass="instance-play-button" wrapText="true"/>
    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
    <Button fx:id="previousInstanceButton" text="‹" accessibleText="Instance précédente" styleClass="instance-arrow"/>
    <Button fx:id="nextInstanceButton" text="›" accessibleText="Instance suivante" styleClass="instance-arrow"/>
   </HBox>
  </StackPane>
  <VBox spacing="6"><Label fx:id="operationStatus" wrapText="true"/><ProgressBar fx:id="instanceProgress" visible="false" managed="false" maxWidth="Infinity"/></VBox>
  <VBox spacing="12" styleClass="surface-card">
   <Label text="Personnaliser ton expérience" styleClass="section-title"/>
   <FlowPane hgap="12" vgap="12" styleClass="instance-actions,content-tabs">
    <Button text="Mods" onAction="#manageMods" styleClass="secondary-button"/><Button text="Resource Packs" onAction="#manageResourcePacks" styleClass="secondary-button"/><Button text="Shaders" onAction="#manageShaders" styleClass="secondary-button"/>
   </FlowPane>
   <VBox fx:id="inlineContentsHost"/>
   <Separator/>
   <Button text="Gérer l’instance" onAction="#manageSelected" styleClass="secondary-button"/>
   <Label text="Mise à jour, déplacement, sauvegarde et configuration de cette instance." wrapText="true" styleClass="muted"/>
  </VBox>
  <VBox spacing="16" styleClass="personal-instances-section">
   <FlowPane hgap="24" vgap="12"><Label text="Mes instances" styleClass="section-title"/><Button fx:id="addInstanceButton" text="Créer" styleClass="secondary-button"/></FlowPane>
   <Label fx:id="localStatus" text="Chargement des installations locales…" wrapText="true" styleClass="muted"/>
   <TilePane fx:id="personalInstancesGrid" hgap="20" vgap="20" prefColumns="3"/>
  </VBox>
 </VBox></content>
</ScrollPane>